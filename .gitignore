# ESP-IDF build output, one per example project.
build/

# Generated by idf.py from sdkconfig.defaults. Deliberately not tracked: it
# pins the target and every menuconfig choice, so a committed one silently
# overrides sdkconfig.defaults for the next person and is the usual reason
# CONFIG_ESP_WIFI_CSI_ENABLED ends up off.
sdkconfig
sdkconfig.old

